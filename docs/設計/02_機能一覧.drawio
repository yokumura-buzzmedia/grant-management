<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-09-02T00:00:00.000Z" agent="Claude" version="24.7.17" type="device" compressed="false">
  <diagram id="function-list" name="機能一覧">
    <mxGraphModel dx="2400" dy="1550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1990" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b style=&quot;font-size:24px&quot;&gt;助成金管理システム 機能一覧（業務機能）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#666666&quot;&gt;出典：01_要件定義.md ／ 2026-09-02時点&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F4E78;strokeColor=#163A5C;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=24;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="2320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;アクター&lt;/b&gt;　［顧客］クライアント　［事務］事務員　［管理］システム管理者　［講師］講師　［社労士］社会保険労務士　［代理店］代理店　［全員］全アクター" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#7EA6C4;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=18;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="2320" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="account" value="&lt;b style=&quot;font-size:17px&quot;&gt;1. 認証・アカウント管理&lt;/b&gt;&lt;br&gt;&lt;br&gt;［全員］DB上の個別アカウントでログイン&lt;br&gt;ログインIDにメールアドレスは使用しない&lt;br&gt;ログインIDは半角英数字と「-」「_」で6〜20文字&lt;br&gt;ログインIDは全体で一意・大文字小文字を区別する&lt;br&gt;画面表示用の利用者名を必須項目として登録&lt;br&gt;1アカウントに複数権限を設定・作成後も変更可能&lt;br&gt;複数権限で許可された操作をすべて利用可能&lt;br&gt;［管理／事務］ログインIDを変更、本人も変更可&lt;br&gt;本人が変更する場合は現在のパスワード入力を必須&lt;br&gt;ログインID変更後は再ログインが必要&lt;br&gt;仮パスワードを自動発行・初回に本人が変更必須&lt;br&gt;パスワード忘れは［管理／事務］が仮パスワードを再生成&lt;br&gt;通常パスワードは8〜20文字・英字と数字を各1文字以上&lt;br&gt;通常パスワード変更時に現パスワードの入力は不要&lt;br&gt;［管理／事務］アカウントの無効化・再有効化&lt;br&gt;［管理］全アカウント、［事務］管理者以外を完全削除&lt;br&gt;完全削除前に確認、削除理由は入力不要&lt;br&gt;削除履歴（利用者名・ログインID）を保持、削除不可&lt;br&gt;担当中は事務員・講師権限の解除と完全削除を禁止&lt;br&gt;最後の有効な管理者は無効化・削除・権限解除を禁止&lt;br&gt;顧客アカウント削除後も会社・案件等の業務データを保持&lt;br&gt;一覧：利用者名・ID・権限・所属会社・状態・更新日時&lt;br&gt;利用者名・ID検索、権限・状態で絞り込み&lt;br&gt;初期表示は有効のみ、作成日時降順・1ページ50件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="740" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="company" value="&lt;b style=&quot;font-size:17px&quot;&gt;2. 会社・顧客管理&lt;/b&gt;&lt;br&gt;&lt;br&gt;［事務／管理］会社を作成し会社名を登録、顧客を招待&lt;br&gt;［顧客／事務／管理］会社情報の入力・編集&lt;br&gt;会社情報はNULL許容で一時保存、未入力でも案件作成可&lt;br&gt;必須項目の入力と受講者1人以上で「契約書送付」へ進行可&lt;br&gt;進行不可の理由（未入力・受講者未登録）を画面に表示&lt;br&gt;法人番号は半角数字13桁・重複登録不可&lt;br&gt;郵便番号7桁・電話番号は数字10桁または11桁&lt;br&gt;郵便番号から住所を自動入力、修正・手入力も可能&lt;br&gt;業種は自由入力、会社形態は6種から選択&lt;br&gt;従業員数・資本金は0以上の整数&lt;br&gt;担当者名・担当者メールはアカウントとは別に管理&lt;br&gt;1顧客アカウントは1社所属・所属変更不可&lt;br&gt;有効な顧客アカウントが0件でも会社データを保持&lt;br&gt;「契約書送付」以降の案件がある会社は必須項目を空に戻せない&lt;br&gt;一覧：会社名・法人番号・担当者名・電話番号・更新日時&lt;br&gt;会社名・法人番号で検索、作成日時降順・1ページ50件&lt;br&gt;［事務／管理］確認後に会社と関連データを完全削除&lt;br&gt;削除履歴（会社名・法人番号）を保持、削除不可" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="830" y="200" width="740" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="application" value="&lt;b style=&quot;font-size:17px&quot;&gt;3. ダッシュボード・申請案件管理&lt;/b&gt;&lt;br&gt;&lt;br&gt;［事務／管理／社労士］ダッシュボードにステータス別案件数&lt;br&gt;ステータス別案件数から絞り込み一覧へ移動&lt;br&gt;［顧客］自社案件一覧を初期表示&lt;br&gt;［講師］担当する講義スケジュールを初期表示&lt;br&gt;［代理店］紹介先の会社の案件一覧を初期表示&lt;br&gt;一覧：番号・会社・案件名・主担当・状態・更新日時&lt;br&gt;会社名・案件番号・案件名で検索、状態・主担当で絞り込み&lt;br&gt;案件番号降順で初期表示、列単位の並び替え・1ページ50件&lt;br&gt;［事務／管理］案件を作成、案件番号を自動発行&lt;br&gt;案件名と主担当事務員（有効な事務員）は必須・変更可&lt;br&gt;担当社労士は設定せず、社労士は全案件を閲覧&lt;br&gt;ステータスは12段階を順に進める（戻す・飛ばすは不可）&lt;br&gt;［事務］手動でステータスを進める、自動変更は行わない&lt;br&gt;［管理］誤操作時のみステータスを修正&lt;br&gt;［事務／管理］状態を問わず案件を完全削除&lt;br&gt;削除履歴（案件番号・会社名）を保持、削除不可" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1620" y="200" width="740" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="documents" value="&lt;b style=&quot;font-size:17px&quot;&gt;4. 必要書類の提出・審査&lt;/b&gt;&lt;br&gt;&lt;br&gt;必要書類の種類と名称はコード側で固定管理&lt;br&gt;管理画面に書類の追加・変更・削除機能は設けない&lt;br&gt;追加・変更・削除はリリース（開発対応）で行う&lt;br&gt;書類構成は全案件で共通、進行中案件にも即時反映&lt;br&gt;追加により未提出が生じてもステータスは戻さない&lt;br&gt;【案件共通の書類】申請案件ごとに提出&lt;br&gt;【受講者別の書類】受講者ごとの雇用契約書（1人1ファイル）&lt;br&gt;雇用契約書は会社に紐づけ、別案件でも使い回す&lt;br&gt;承認は会社単位で一度だけ、全案件で承認済みとして扱う&lt;br&gt;［顧客］書類の提出と不備時の再提出&lt;br&gt;1種類につき1ファイル（PDF／JPEG／PNG・50MB）&lt;br&gt;［事務］内容確認・承認、不備は掲示板でコメントし再提出依頼&lt;br&gt;全書類と全受講者の雇用契約書の承認で「書類収集完了」可&lt;br&gt;受講者を追加した場合は追加分の承認まで進行不可&lt;br&gt;差し替え時は承認を取消し再承認（会社の全案件に波及）&lt;br&gt;提出・再提出時に事務員へシステム内通知&lt;br&gt;差し替え前のファイルと提出履歴は保存しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="740" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="schedule" value="&lt;b style=&quot;font-size:17px&quot;&gt;5. 講義予約・スケジュール管理&lt;/b&gt;&lt;br&gt;&lt;br&gt;［顧客］案件を選び2／3／4／5日間から受講日数を選択&lt;br&gt;全10時間を日数で配分（2日=5h×2、3日=3h/3h/4h）&lt;br&gt;（4日=2.5h×4、5日=2h×5）&lt;br&gt;講義日と開始時刻を選択、終了時刻は自動計算&lt;br&gt;土日祝と個別休業日を予約不可日とする&lt;br&gt;［事務／管理］個別休業日の登録・変更&lt;br&gt;講義の空き日程は個別に登録しない&lt;br&gt;申請時点で枠を確保（上限＝有効な講師数－1）&lt;br&gt;講師数が減っても受付済みの予約は維持&lt;br&gt;［事務］予約承認時に担当講師を指定して確定&lt;br&gt;同一講師への同一日時の重複割当を禁止&lt;br&gt;承認前は顧客が変更・取消、確定後は事務／管理のみ&lt;br&gt;取消・却下時に枠を即時解放（却下理由の通知はしない）&lt;br&gt;確定時と確定後の変更・取消時に顧客と講師へ通知&lt;br&gt;［講師］自分が担当するスケジュールのみ確認" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="830" y="720" width="740" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="team" value="&lt;b style=&quot;font-size:17px&quot;&gt;6. チーム・受講者管理&lt;/b&gt;&lt;br&gt;&lt;br&gt;［管理／事務］予約後にチームを作成（予約枠と1対1）&lt;br&gt;予約申請時点では仮のチームを登録しない&lt;br&gt;取消・却下後もチームを保存し、新しい枠へ再利用可&lt;br&gt;チーム名と受講者を登録、人数の上限・下限は設けない&lt;br&gt;［顧客］会社情報の登録と同じタイミングで受講者を初回登録&lt;br&gt;受講者の登録項目：氏名・雇用保険被保険者番号・雇用形態&lt;br&gt;3項目すべて必須、被保険者番号は半角数字11桁&lt;br&gt;同一会社内で被保険者番号の重複登録は不可&lt;br&gt;雇用形態は正社員・契約社員・パート・派遣・その他&lt;br&gt;［顧客／事務／管理］受講者情報の編集・削除&lt;br&gt;受講者は会社に紐づき、同一会社の別案件で再利用可&lt;br&gt;同一案件内で複数チームへの重複登録を禁止&lt;br&gt;受講者削除時はチーム・雇用契約書・過去記録からも削除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1620" y="720" width="740" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="curriculum" value="&lt;b style=&quot;font-size:17px&quot;&gt;7. カリキュラム管理&lt;/b&gt;&lt;br&gt;&lt;br&gt;6つのマスタで構成する&lt;br&gt;研修プログラム／職種カテゴリ／コース／講義コマ／&lt;br&gt;開催パターン／パターン日別コマ割当&lt;br&gt;各マスタは一意のコードを持ち、登録後は変更しない&lt;br&gt;名称は文字列で持たせず、マスタのコードで参照する&lt;br&gt;研修プログラム2件・職種カテゴリ7件&lt;br&gt;コースは1プログラム66件・全体132件&lt;br&gt;1コースのコマ数は可変、所要時間0.5h単位で合計10時間&lt;br&gt;開催パターン4件、日別コマ割当はコースごとに保持&lt;br&gt;［管理／事務］各マスタの登録・編集（［顧客］は不可）&lt;br&gt;管理画面のCSVインポートでマスタごとに一括登録・更新&lt;br&gt;初期データはCSVインポートで登録（docs/data/）&lt;br&gt;予約後にチームへコースを登録（132通りから1つ）&lt;br&gt;紐づけ時にコース・講義コマ・日別割当をチームへ複製&lt;br&gt;複製後はマスタを変更しても内容は変わらない&lt;br&gt;研修プログラム名・職種カテゴリ名は最新のマスタ名を表示&lt;br&gt;参照されているマスタは削除不可・無効化のみ（再有効化可）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="740" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="contract" value="&lt;b style=&quot;font-size:17px&quot;&gt;8. 契約書・FREE SIGN連携&lt;/b&gt;&lt;br&gt;&lt;br&gt;［事務］本システムから契約書の送付操作を実行&lt;br&gt;FREE SIGNへ契約書の作成・送付を自動連携&lt;br&gt;署名依頼メールはFREE SIGNから送信（本システムは送らない）&lt;br&gt;送付先は会社情報の担当者メールアドレス&lt;br&gt;［顧客］ログインせず署名依頼メールから署名&lt;br&gt;契約締結はFREE SIGN上で行う&lt;br&gt;締結済みPDFを本システムが自動取得して保存&lt;br&gt;［事務］署名依頼メールの再送（送付先は初回と同じ）&lt;br&gt;未署名のまま経過しても自動催促メールは送らない&lt;br&gt;［事務］送付を取消（FREE SIGN側の署名依頼も無効化）&lt;br&gt;取消してもステータスは「契約書送付」のまま戻さない&lt;br&gt;取消後は内容を修正して改めて送付可能&lt;br&gt;締結済みの契約書は取消・再送とも不可&lt;br&gt;1案件につき契約書は1つ&lt;br&gt;［事務］締結を確認後にステータスを手動更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="830" y="1120" width="740" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="billing" value="&lt;b style=&quot;font-size:17px&quot;&gt;9. 見積・発注・請求・入金管理&lt;/b&gt;&lt;br&gt;&lt;br&gt;見積書と発注書は1つの「見積もり兼発注書」とする&lt;br&gt;登録データから自動生成、生成だけでは送付しない&lt;br&gt;［事務］送付操作を実行したときだけメールで送付&lt;br&gt;送付先は会社情報の担当者メールアドレス&lt;br&gt;［顧客］署名・押印済みの書類をアップロードして提出&lt;br&gt;形式はPDF／JPEG／PNG・50MB・1ファイル&lt;br&gt;差し替え時は前のファイルと提出履歴を保存しない&lt;br&gt;アップロード時に事務員へシステム内通知&lt;br&gt;［事務］不備がある場合はコメントを添えて再提出を依頼&lt;br&gt;［事務］内容を確認後にステータスを手動更新&lt;br&gt;請求書も登録データから自動生成・送付操作時のみ送付&lt;br&gt;［事務］入金を確認後にステータスを手動更新&lt;br&gt;1案件につき見積もり兼発注書・請求書は各1つ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1620" y="1120" width="740" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="training" value="&lt;b style=&quot;font-size:17px&quot;&gt;10. 研修実施・出欠管理&lt;/b&gt;&lt;br&gt;&lt;br&gt;［事務］「研修中」「研修完了」へ手動でステータス更新&lt;br&gt;［事務］助成金の受給を確認&lt;br&gt;［事務］「助成金受給済」「完了」へ手動でステータス更新&lt;br&gt;各講義日の実施結果（実施済み・中止）は記録しない&lt;br&gt;出欠は全受講者を「出席」として扱うことを既定とする&lt;br&gt;出席の場合は講師・事務員とも入力を行わない&lt;br&gt;遅刻・早退・欠席が発生した場合のみ専用メニューから記録&lt;br&gt;記録項目：講義日・チーム・受講者・区分・備考&lt;br&gt;記録がない受講者はすべて出席とみなす&lt;br&gt;［講師］自分が担当する講義日のみ登録・編集・削除&lt;br&gt;［事務］すべての講義日の記録を登録・編集・削除&lt;br&gt;［顧客］自社案件の記録を閲覧のみ（登録・編集は不可）&lt;br&gt;遅刻・早退の時刻や受講できなかった時間は記録しない&lt;br&gt;補足が必要な場合は備考に自由入力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="1520" width="740" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="board" value="&lt;b style=&quot;font-size:17px&quot;&gt;11. 案件掲示板・共通通知&lt;/b&gt;&lt;br&gt;&lt;br&gt;案件ごとに掲示板を設置し、閲覧できる全アクターが利用&lt;br&gt;［代理店］掲示板の閲覧のみ可、投稿は不可&lt;br&gt;提出書類ごとの個別コメント欄は設けない&lt;br&gt;自分以外の新しい投稿を未読とし、タブ表示時に既読化&lt;br&gt;掲示板の未読は掲示板タブのバッジで表示&lt;br&gt;［投稿者］自分の投稿を編集・削除&lt;br&gt;投稿にファイル添付可（PDF／JPEG／PNG・50MB）&lt;br&gt;掲示板の新しい投稿は共通通知の対象外&lt;br&gt;共通通知をベルアイコンから一覧表示・未読件数をバッジ表示&lt;br&gt;通知選択時に既読化して対象の案件・予約画面へ移動&lt;br&gt;「すべて既読にする」操作を設ける&lt;br&gt;過去の通知は自動削除せず全件保存&lt;br&gt;［社労士］コメントで事務員をフォロー（案件編集は不可）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="830" y="1520" width="740" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="agency" value="&lt;b style=&quot;font-size:17px&quot;&gt;12. 代理店&lt;/b&gt;&lt;br&gt;&lt;br&gt;代理店はクライアントを紹介した外部の協力会社&lt;br&gt;代理店（組織）は代理店マスタで管理&lt;br&gt;登録項目：代理店コード・代理店名・有効／無効&lt;br&gt;［事務／管理］代理店マスタの登録・編集&lt;br&gt;代理店アカウントは必ず1つの代理店に紐づける&lt;br&gt;1つの代理店に複数の代理店アカウントを作成可能&lt;br&gt;［事務／管理］会社情報に紹介代理店を設定・変更&lt;br&gt;紹介代理店の設定は任意、1社につき1つ、必須項目には含めない&lt;br&gt;［代理店］自社が紹介代理店の会社の案件のみ閲覧&lt;br&gt;閲覧できる範囲はその会社の顧客と同じ&lt;br&gt;会社情報・受講者・提出書類・契約書・見積・請求・予約を閲覧&lt;br&gt;登録・編集・削除・書類提出・予約・状態変更はすべて不可&lt;br&gt;代理店には共通通知を送らない&lt;br&gt;紹介代理店を変更すると変更前の代理店からは見えなくなる&lt;br&gt;代理店マスタを無効化すると所属アカウントはログイン不可&lt;br&gt;会社に設定済みの代理店マスタは削除不可・無効化のみ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1620" y="1520" width="740" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="function-list_footer" value="管理・利用環境・性能・セキュリティ・お知らせ・TODOは2ページ目に整理。" style="whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#666666;align=right;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1910" width="2320" height="35" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="management-environment" name="管理・利用環境・TODO">
    <mxGraphModel dx="2400" dy="1550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1570" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b style=&quot;font-size:24px&quot;&gt;助成金管理システム 機能一覧（管理・利用環境・TODO）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#666666&quot;&gt;出典：01_要件定義.md ／ 2026-09-02時点&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F4E78;strokeColor=#163A5C;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=24;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="2320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;構成&lt;/b&gt;　13-1 システム管理・更新情報　13-2 利用環境・セッション　13-3 インフラ・規模　13-4 性能・画面動作　13-5 セキュリティ　13-6 お知らせ　14 TODO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#7EA6C4;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=18;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="2320" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p2_admin_core" value="&lt;b style=&quot;font-size:17px&quot;&gt;13-1. システム管理・更新情報&lt;/b&gt;&lt;br&gt;&lt;br&gt;［管理］設定変更・誤操作時のデータ修正&lt;br&gt;［管理］システム管理者アカウントを作成（複数登録可）&lt;br&gt;システム管理者アカウントもDBで管理する&lt;br&gt;［管理／事務］個別休業日の登録・変更&lt;br&gt;講師マスタの有効／無効を管理し、有効講師数を予約枠上限へ反映&lt;br&gt;講師が減少しても既存の予約は維持する&lt;br&gt;アクターごとの閲覧・編集権限を制御&lt;br&gt;会社情報・案件・書類・予約などに作成日時と作成者を保存&lt;br&gt;あわせて最終更新日時と最終更新者を保存&lt;br&gt;更新のたびに履歴を追加せず、最新の更新情報のみ保持&lt;br&gt;会社情報・案件の変更前後の内容は保存しない&lt;br&gt;自動処理による更新は最終更新者を「システム」とする&lt;br&gt;各データの詳細画面に最終更新日時と最終更新者を表示&lt;br&gt;操作履歴を一覧表示・閲覧する機能は設けない&lt;br&gt;案件の削除履歴は完全削除後も例外として保存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="1130" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="p2_session" value="&lt;b style=&quot;font-size:17px&quot;&gt;13-2. 利用環境・セッション管理&lt;/b&gt;&lt;br&gt;&lt;br&gt;PC・スマートフォンの両方で利用できるWebシステム&lt;br&gt;スマートフォンはWebブラウザから利用、専用アプリは作らない&lt;br&gt;Chrome・Edge・Safariの各最新版に対応&lt;br&gt;同一アカウントで複数端末・複数ブラウザの同時ログインを許可&lt;br&gt;無操作時間による自動ログアウトは行わない&lt;br&gt;ブラウザを閉じて再度開いてもログイン状態を維持&lt;br&gt;ログイン状態の最長有効期間はログイン時点から30日&lt;br&gt;パスワード変更時は操作端末を含む全端末をログアウト&lt;br&gt;仮パスワード再生成時はそのアカウントの全端末をログアウト&lt;br&gt;無効化・完全削除時は全端末を直ちにログアウト&lt;br&gt;権限の追加・変更・解除は全端末へ直ちに反映&lt;br&gt;通常のログアウト操作は操作した端末のみ&lt;br&gt;利用者による全端末の一括ログアウト機能は設けない&lt;br&gt;管理者・事務員による強制ログアウト機能は設けない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1230" y="200" width="1130" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="p2_infra" value="&lt;b style=&quot;font-size:17px&quot;&gt;13-3. インフラ・バックアップ・想定規模&lt;/b&gt;&lt;br&gt;&lt;br&gt;インフラストラクチャはAWSの利用を前提とする&lt;br&gt;DBとアップロード済みファイルを1日1回自動でバックアップ&lt;br&gt;バックアップの保存期間は30日間&lt;br&gt;保管先は本番環境と同じAWSアカウント内の専用の場所&lt;br&gt;保管先は本番のDB・ファイル保存先とは別に用意する&lt;br&gt;保管先に削除保護を設定し、保存期間中は削除できないようにする&lt;br&gt;保管先へのアクセス権限は本番環境の実行権限とは分けて設定&lt;br&gt;別AWSアカウントや別リージョンへの複製は行わない&lt;br&gt;運用開始時：約100社・約100〜500案件&lt;br&gt;将来最大：約10,000社・約50,000案件&lt;br&gt;1社あたりの申請案件数は1〜5件&lt;br&gt;最大同時利用者数は30人" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="1130" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="p2_performance" value="&lt;b style=&quot;font-size:17px&quot;&gt;13-4. 性能要件・処理中の画面動作&lt;/b&gt;&lt;br&gt;&lt;br&gt;通常の画面表示・検索・保存は原則3秒以内&lt;br&gt;PDF生成は原則10秒以内&lt;br&gt;ファイルアップロード・メール・外部サービス通信は対象外&lt;br&gt;最大50MBのアップロードでも進捗状況は表示しない&lt;br&gt;処理中は進捗率を示さないプログレススピナーを表示&lt;br&gt;スピナー表示中は同じ操作を含む他の操作を行えない&lt;br&gt;処理に失敗した場合はエラーメッセージを表示&lt;br&gt;エラー発生後は利用者が対象の処理を再実行できる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1230" y="570" width="1130" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="p2_security" value="&lt;b style=&quot;font-size:17px&quot;&gt;13-5. セキュリティ・不正アクセス対策&lt;/b&gt;&lt;br&gt;&lt;br&gt;ログイン画面へのリクエストをAWS WAFでレート制限&lt;br&gt;レート制限は送信元IPアドレス単位で行う&lt;br&gt;レート制限はアカウントの無効化・ロックを伴わない&lt;br&gt;レート制限の具体的なしきい値は技術設計時に決定する&lt;br&gt;ログインに多要素認証は使用しない&lt;br&gt;ログイン失敗が連続してもアカウントの自動ロックは行わない&lt;br&gt;通常パスワード変更時の本人確認は求めない&lt;br&gt;仮パスワードに有効期限は設けない&lt;br&gt;現在または過去に使用したパスワードの再利用を許可する&lt;br&gt;運用開始後に要件が変わった場合は改めて見直す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="1130" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="p2_announcement" value="&lt;b style=&quot;font-size:17px&quot;&gt;13-6. お知らせ&lt;/b&gt;&lt;br&gt;&lt;br&gt;管理画面に全利用者へ表示するお知らせの編集機能を設ける&lt;br&gt;内容と表示ON／OFFを編集できるのはシステム管理者のみ&lt;br&gt;リンク・太字・斜体・下線・文字色・文字サイズに対応&lt;br&gt;本文は最大1,000文字、画像・動画・ファイルは添付不可&lt;br&gt;ONにする前に実際の表示内容をプレビューできる&lt;br&gt;OFF中も内容と文字装飾を保持、ONにする場合は本文が必須&lt;br&gt;ON中に内容を保存した場合は全画面へ即時反映&lt;br&gt;ログイン画面を含む全画面へ共通バナーとして1件のみ表示&lt;br&gt;利用者は表示中のバナーを閉じられる&lt;br&gt;閉じた状態は保存せず、再読み込み・再起動で再表示&lt;br&gt;内容変更時もOFF→ONに戻した場合も全利用者へ再表示&lt;br&gt;リンクは新しいタブを開かず現在のタブで開く&lt;br&gt;表示開始・終了日時による予約表示は設けず手動で切り替える&lt;br&gt;重大な障害を検知してもシステム管理者へメール通知は送らない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1230" y="890" width="1130" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="p2_todo" value="&lt;b style=&quot;font-size:17px&quot;&gt;14. 要検討・TODO&lt;/b&gt;&lt;br&gt;&lt;br&gt;雇用契約書以外の必要書類の具体的な名称と種類（5.2）&lt;br&gt;欠席後のフォロー（振替受講）を本システムで扱うか（5.11）&lt;br&gt;申請案件のステータス全般（5、5.1）&lt;br&gt;　・「契約書送付」の手前に案件作成直後の状態を設けるか&lt;br&gt;　・各ステータスへ進むための条件&lt;br&gt;　・変更できるアクターと、例外的に戻せる場合の扱い&lt;br&gt;　※12段階の構成は暫定。確定まで設計は仮置き&lt;br&gt;　※整理と要検討事項は 11_ステータスの遷移.drawio に集約" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;dashed=1;fontColor=#7F6000;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="1240" width="1130" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="management-environment_footer" value="確定済み要件を項目別に分割。黄色の破線枠は未確定事項。" style="whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#666666;align=right;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1490" width="2320" height="35" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
