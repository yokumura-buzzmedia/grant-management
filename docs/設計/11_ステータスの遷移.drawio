        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A5A5A;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="s7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c6" value="会社に登録されているすべての受講者の雇用契約書が承認済みであること（5.2）&lt;br&gt;承認は会社単位で一度だけ行い、同じ会社のすべての申請案件で承認済みとして扱う" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontColor=#1F2937;align=left;verticalAlign=middle;spacing=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="1045" width="720" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A5A5A;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s7" target="s8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c7" value="クライアントの予約申請を事務員が承認し、担当講師を指定して&lt;br&gt;講義スケジュールを確定する（5.5）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontColor=#1F2937;align=left;verticalAlign=middle;spacing=12;fontSize=12;" vertex="1" parent="1">
