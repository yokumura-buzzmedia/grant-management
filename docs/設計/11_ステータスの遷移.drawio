                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c2" value="事務員が本システムから契約書の送付操作を実行し、FREE SIGNへ連携する（5.8）&lt;br&gt;署名依頼メールはFREE SIGNから会社の担当者メールアドレスへ送信される" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontColor=#1F2937;align=left;verticalAlign=middle;spacing=12;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="460" y="525" width="720" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A5A5A;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s3" target="s4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c3" value="FREE SIGN上で契約締結を確認したうえで、事務員が手動で進める（5.8）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontColor=#1F2937;align=left;verticalAlign=middle;spacing=12;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="460" y="655" width="720" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A5A5A;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s4" target="s5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c4" value="【未確定】会社情報の入力開始。要件5.3ではクライアントを招待して入力させる流れ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;dashed=1;fontColor=#7F6000;align=left;verticalAlign=middle;spacing=12;fontSize=12;" parent="1" vertex="1">
