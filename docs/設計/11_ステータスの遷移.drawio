          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="事務員が本システムから契約書の送付操作を実行し、FREE SIGNへ連携する（5.8）&lt;br&gt;契約書はfreeeサインのテンプレートから生成する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontColor=#1F2937;align=left;verticalAlign=middle;spacing=12;fontSize=12;" vertex="1" parent="1">
