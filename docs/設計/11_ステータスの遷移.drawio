        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A5A5A;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s21" target="s22">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c21" value="【未確定】事務員が助成金の支給申請を行い、完了を記録する操作が未定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;dashed=1;fontColor=#7F6000;align=left;verticalAlign=middle;spacing=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="2995" width="720" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A5A5A;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s22" target="s23">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c22" value="助成金の受給までには半年から1年程度のラグがあるため、&lt;br&gt;本システムでは受給を確認せず、支給申請の完了をもって完了とする（5.11）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontColor=#1F2937;align=left;verticalAlign=middle;spacing=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="3125" width="720" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="inq" value="&lt;b&gt;25&lt;/b&gt;　問い合わせ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1F2937;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="460" y="3200" width="330" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_inq_out" value="問い合わせ発生" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B85450;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#B85450;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="s23" target="inq">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_inq_back" value="対応完了" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B85450;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#B85450;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="inq" target="s23">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="terminal_note" value="&lt;b&gt;24 完了 が終端です。&lt;/b&gt;　助成金の受給までには半年から1年程度のラグがあるため、本システムでは受給を確認せず、支給申請の完了をもって完了として扱います（5.11）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82B366;dashed=1;fontColor=#1F2937;align=left;verticalAlign=middle;spacing=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="3275" width="1080" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p_scope" value="&lt;b style=&quot;font-size:16px&quot;&gt;この図について&lt;/b&gt;&lt;br&gt;&lt;br&gt;申請案件のステータスです。営業開始から完了までを1本の流れで管理します。&lt;br&gt;&lt;br&gt;顧客（会社）と申請案件で分けず、1本にマージした構成です。&lt;br&gt;&lt;b&gt;会社にステータスを持たせる概念はありません。&lt;/b&gt;&lt;br&gt;&lt;br&gt;1〜8は顧客の受入に相当する区間、9〜24は案件の実務に相当する区間です。&lt;br&gt;&lt;b&gt;申請案件は 1 営業中 の時点で作成し、1レコードが1〜24を保持します。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1230" y="210" width="740" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="p_inquiry" value="&lt;b style=&quot;font-size:16px&quot;&gt;完了後の問い合わせ対応（25）&lt;/b&gt;&lt;br&gt;&lt;br&gt;24 完了 の後に問い合わせが発生した場合、&lt;br&gt;25 問い合わせ へ変更し、対応が終われば 24 へ戻します。&lt;br&gt;&lt;br&gt;&lt;b&gt;これは本フローで唯一、前の状態へ戻る遷移です。&lt;/b&gt;&lt;br&gt;要件5.1の「原則として、前のステータスには戻せない」に対する例外です。&lt;br&gt;&lt;br&gt;未確定：問い合わせの内容を本システムで記録するか（案件掲示板で足りるか）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1230" y="450" width="740" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="p_rule" value="&lt;b style=&quot;font-size:16px&quot;&gt;ステータス変更ルール（5.1）&lt;/b&gt;&lt;br&gt;&lt;br&gt;ステータスを主に次へ進めるのは事務員とする&lt;br&gt;ステータスは決められた順序で進める&lt;br&gt;原則として、前のステータスには戻せない（例外は25 問い合わせ）&lt;br&gt;原則として、途中のステータスを飛ばせない&lt;br&gt;事務員が手動で次のステータスへ進める&lt;br&gt;現時点では、ステータスの自動変更は行わない&lt;br&gt;誤操作時のみ、システム管理者がステータスを修正できる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1230" y="690" width="740" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="p_doc" value="&lt;b style=&quot;font-size:16px&quot;&gt;必要書類との対応（5.2）&lt;/b&gt;&lt;br&gt;&lt;br&gt;必要書類は2種類です。申請案件ごとに提出する「案件共通の書類」は設けません。&lt;br&gt;&lt;br&gt;受講者別の雇用契約書　→　7 雇用契約書提出中 〜 8 雇用契約書提出済&lt;br&gt;　会社に紐づけて管理し、承認は会社単位で一度だけ行う。&lt;br&gt;&lt;br&gt;支給申請用の書類　　　→　21 必要書類収集中 〜 22 必要書類収集完了&lt;br&gt;　申請案件に紐づけて管理する。種類と名称は未確定。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1230" y="930" width="740" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="p_todo" value="&lt;b style=&quot;font-size:16px&quot;&gt;確定させる必要がある点&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 遷移条件が未定の箇所&lt;br&gt;　　1→2、2→3、5→6、6→7、13→14、14→15、15→16、19→20、22→23&lt;br&gt;2. 各ステータスを変更できるアクター&lt;br&gt;3. 支給申請用の書類の種類と名称&lt;br&gt;4. 25 問い合わせ の内容を本システムで記録するか" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1230" y="1170" width="740" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="p_legend" value="&lt;b style=&quot;font-size:16px&quot;&gt;凡例&lt;/b&gt;&lt;br&gt;&lt;br&gt;実線枠　確定した状態（24 完了 が終端）&lt;br&gt;赤枠　　完了後の例外的な状態と、その往復遷移&lt;br&gt;白枠　　遷移条件が確定している箇所&lt;br&gt;黄破線枠　遷移条件が未確定の箇所&lt;br&gt;左端の破線　業務フェーズの区切り（説明用。仕様ではない）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1230" y="1370" width="740" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="footer" value="遷移条件の一部が未確定。確定後に本図と 01_要件定義.md・04_DB論理設計.md を更新する。" style="whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#666666;align=right;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="3375" width="1930" height="35" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
