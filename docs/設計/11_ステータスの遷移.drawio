          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c5" value="【未確定】会社情報の必須項目の入力完了と対応する可能性&lt;br&gt;要件5.3の「必須項目がすべて入力され、受講者が1人以上」との関係が未整理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;dashed=1;fontColor=#7F6000;align=left;verticalAlign=middle;spacing=12;fontSize=12;" vertex="1" parent="1">
