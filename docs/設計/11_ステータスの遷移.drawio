          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c9" value="見積もり兼発注書を登録データから自動生成し、事務員が送付操作を実行する（5.9）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontColor=#1F2937;align=left;verticalAlign=middle;spacing=12;fontSize=12;" vertex="1" parent="1">
