                <mxCell id="c19" value="【未確定】支給申請の案内をクライアントへ行ったことを記録する操作が未定&lt;br&gt;&lt;b&gt;要件定義書に記載がない工程&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;dashed=1;fontColor=#7F6000;align=left;verticalAlign=middle;spacing=12;fontSize=12;" parent="1" vertex="1">
