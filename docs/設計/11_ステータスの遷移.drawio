                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c9" value="事務員またはシステム管理者が、チームを作成してコースを登録する（5.6, 5.7）&lt;br&gt;紐づけ時にコース・講義コマ・日別割当をチームへ複製する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontColor=#1F2937;align=left;verticalAlign=middle;spacing=12;fontSize=12;" parent="1" vertex="1">
