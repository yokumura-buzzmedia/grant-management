                <mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A5A5A;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s20" target="s21" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c20" value="【未確定】支給申請に必要な書類の収集を開始する状態と想定&lt;br&gt;要件5.2の「必要書類の提出・確認フロー」との関係が未整理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;dashed=1;fontColor=#7F6000;align=left;verticalAlign=middle;spacing=12;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="460" y="2865" width="720" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="e21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A5A5A;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s21" target="s22" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c21" value="【未確定】「必要書類収集中」が終端かどうかが未確認&lt;br&gt;支給申請済・助成金受給済・完了に相当する状態の要否" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;dashed=1;fontColor=#7F6000;align=left;verticalAlign=middle;spacing=12;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="460" y="2995" width="720" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p_scope" value="&lt;b style=&quot;font-size:16px&quot;&gt;この図について&lt;/b&gt;&lt;br&gt;&lt;br&gt;申請案件のステータスです。営業開始から支給申請までを1本の流れで管理します。&lt;br&gt;&lt;br&gt;以前は顧客（会社）と申請案件で2軸に分けていましたが、1本にマージしました。&lt;br&gt;&lt;b&gt;会社にステータスを持たせる概念はありません。&lt;/b&gt;&lt;br&gt;&lt;br&gt;1〜8は旧「顧客ステータス」、9〜22は旧「案件ステータス」に相当する区間です。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="1230" y="210" width="740" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p_rule" value="&lt;b style=&quot;font-size:16px&quot;&gt;ステータス変更ルール（5.1）&lt;/b&gt;&lt;br&gt;&lt;br&gt;ステータスを主に次へ進めるのは事務員とする&lt;br&gt;ステータスは決められた順序で進める&lt;br&gt;原則として、前のステータスには戻せない&lt;br&gt;原則として、途中のステータスを飛ばせない&lt;br&gt;事務員が手動で次のステータスへ進める&lt;br&gt;現時点では、ステータスの自動変更は行わない&lt;br&gt;誤操作時のみ、システム管理者がステータスを修正できる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="1230" y="430" width="740" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p_gap" value="&lt;b style=&quot;font-size:16px&quot;&gt;要件定義書との差分（要確認）&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 申請案件レコードを作成する時点&lt;br&gt;　　1〜8を申請案件が保持するなら、レコードは「営業中」から存在する。&lt;br&gt;　　その場合、9「新規」が何を指すのかを整理する必要がある。&lt;br&gt;&lt;br&gt;2. 「書類収集完了」に相当する状態がない&lt;br&gt;　　要件5.2は「全書類と全受講者の雇用契約書が承認済みになるまで&lt;br&gt;　　『書類収集完了』へ進めない」と定めている。&lt;br&gt;　　雇用契約書は8で担保されるが、案件共通の必要書類の扱いが不明。&lt;br&gt;&lt;br&gt;3. 22「必要書類収集中」と要件5.2の必要書類が同じものか不明&lt;br&gt;　　支給申請用の別の書類である可能性がある。&lt;br&gt;&lt;br&gt;4. 旧12段階にあった「助成金受給済」「完了」の扱いが不明" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="1230" y="670" width="740" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="p_todo" value="&lt;b style=&quot;font-size:16px&quot;&gt;確定させる必要がある点&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 「必要書類収集中」の後に続く状態（終端かどうか）&lt;br&gt;2. 1〜3、6、9、15〜17、21 の遷移条件&lt;br&gt;3. 各ステータスを変更できるアクター&lt;br&gt;4. 前のステータスへ戻せる例外の有無&lt;br&gt;5. 左記「要件定義書との差分」4点の整理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="1230" y="1020" width="740" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="p_legend" value="&lt;b style=&quot;font-size:16px&quot;&gt;凡例&lt;/b&gt;&lt;br&gt;&lt;br&gt;実線枠　ヒアリングで確定した状態&lt;br&gt;破線枠　継続の有無が未確認&lt;br&gt;白枠　　要件定義書に根拠がある遷移条件&lt;br&gt;黄破線枠　遷移条件が未確定、または要件定義書に記載がない工程&lt;br&gt;左端の破線　業務フェーズの区切り（説明用。仕様ではない）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#1F2937;align=left;verticalAlign=top;spacing=16;spacingTop=14;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="1230" y="1220" width="740" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="footer" value="遷移条件と要件定義書との差分は未整理。確定後に本図と 01_要件定義.md・04_DB論理設計.md を更新する。" style="whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#666666;align=right;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="3150" width="1930" height="35" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>