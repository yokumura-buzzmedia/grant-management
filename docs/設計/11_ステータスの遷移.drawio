        <mxCell id="c18" value="【未確定】支給申請の案内を行ったことを記録する操作が未定&lt;br&gt;&lt;b&gt;ステータスの記録のみ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;dashed=1;fontColor=#7F6000;align=left;verticalAlign=middle;spacing=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="2605" width="720" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A5A5A;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s19" target="s20">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c19" value="&lt;b&gt;支給申請用の書類&lt;/b&gt;の収集を開始する。要件5.2の必要書類とは別の書類&lt;br&gt;project_documents で管理する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontColor=#1F2937;align=left;verticalAlign=middle;spacing=12;fontSize=12;" vertex="1" parent="1">
