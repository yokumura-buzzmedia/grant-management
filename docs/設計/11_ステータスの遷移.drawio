                <mxCell id="c0" value="【未確定】「内諾」と判断する条件と、それを記録する操作が未定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;dashed=1;fontColor=#7F6000;align=left;verticalAlign=middle;spacing=12;fontSize=12;" parent="1" vertex="1">
