# ローカル開発用の設定。値をそのまま .env.local へコピーして使う。
# docker-compose.yml の MySQL はホスト側 3307 で公開している。
DATABASE_URL="mysql://grant:grant@127.0.0.1:3307/grant_management"

# 初期システム管理者（npm run db:seed で作成する）
SEED_ADMIN_LOGIN_ID="admin001"
SEED_ADMIN_DISPLAY_NAME="初期管理者"

# ファイル保管（S3互換）。ローカルは docker compose の MinIO を使う。
# 本番の S3 では S3_ENDPOINT を外し、鍵は ECS のタスクロールから取るため
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY も設定しない。
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="ap-northeast-1"
S3_BUCKET="grant-management"
S3_ACCESS_KEY_ID="grant"
S3_SECRET_ACCESS_KEY="grantgrant"
