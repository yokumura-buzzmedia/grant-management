# ローカル開発用の設定。値をそのまま .env.local へコピーして使う。
# docker-compose.yml の MySQL はホスト側 3307 で公開している。
DATABASE_URL="mysql://grant_app:password@127.0.0.1:3307/grant_management"

# 初期システム管理者（npm run db:seed で作成する）
SEED_ADMIN_LOGIN_ID="admin001"
SEED_ADMIN_DISPLAY_NAME="初期管理者"

# ファイル保管（S3互換）。ローカルは docker compose の MinIO を使う。
# 本番の S3 では S3_ENDPOINT を外し、鍵は ECS のタスクロールから取るため
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY も設定しない。
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="ap-northeast-1"
S3_BUCKET="grant-management"
S3_ACCESS_KEY_ID="grant"
S3_SECRET_ACCESS_KEY="grantgrant"

# freeeサイン（電子契約）。05_外部連携仕様.md 3
# FREEE_SIGN_MODE は live / mock のいずれか。未設定なら連携そのものを使わせない。
# ローカルはクレデンシャルを置かないので mock。ステージングと本番は live。
FREEE_SIGN_MODE="mock"
# live のときだけ必要。client_id / client_secret は AWS では Secrets Manager から渡す。
# freeeサインは OAuth 2.0 クライアントしか発行できないため、管理者が一度ブラウザで
# 認可する。リダイレクトURIは freeeサイン側の登録値と完全一致していないと弾かれる。
# FREEE_SIGN_BASE_URL="https://ninja-sign.com"
# FREEE_SIGN_CLIENT_ID=""
# FREEE_SIGN_CLIENT_SECRET=""
# FREEE_SIGN_REDIRECT_URI="http://localhost:3000/settings/freee-sign/callback"
# 契約書のテンプレートID（7章6・未確定）
# FREEE_SIGN_TEMPLATE_ID=""
# 送信ユーザーID。GET /v1/users で調べる（7章6・未確定）
# FREEE_SIGN_SENDER_ID=""
# 契約書を入れるフォルダID。GET /v1/folders で調べる。
# **環境の分離はこの値だけが担保する。** 本番とステージングで必ず別の値にする。
# FREEE_SIGN_FOLDER_ID=""
